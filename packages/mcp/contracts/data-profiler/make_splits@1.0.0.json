{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "oot_vintages": {
        "default": [],
        "items": {
          "type": "integer"
        },
        "title": "Oot Vintages",
        "type": "array"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "strategy": {
        "enum": [
          "vintage",
          "stratified_random"
        ],
        "title": "Strategy",
        "type": "string"
      },
      "val_share": {
        "default": 0.2,
        "title": "Val Share",
        "type": "number"
      }
    },
    "required": [
      "dataset_id",
      "strategy",
      "seed"
    ],
    "title": "MakeSplitsInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "data-profiler",
  "tool": "make_splits",
  "version": "1.0.0"
}
