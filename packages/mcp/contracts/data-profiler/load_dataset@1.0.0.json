{
  "input_schema": {
    "$defs": {
      "DatasetRef": {
        "additionalProperties": false,
        "description": "A dataset adapter name plus the seed it is loaded with, written `adapter[@seed]`.",
        "properties": {
          "adapter": {
            "title": "Adapter",
            "type": "string"
          },
          "seed": {
            "default": 42,
            "title": "Seed",
            "type": "integer"
          }
        },
        "required": [
          "adapter"
        ],
        "title": "DatasetRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "dataset_ref": {
        "$ref": "#/$defs/DatasetRef"
      }
    },
    "required": [
      "dataset_ref"
    ],
    "title": "LoadDatasetInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "producer": {
            "anyOf": [
              {
                "$ref": "#/$defs/Producer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "summary": {
            "additionalProperties": true,
            "title": "Summary",
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "media_type",
          "size_bytes"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "dataset": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "dictionary": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "n_rows": {
        "title": "N Rows",
        "type": "integer"
      },
      "oot_capable": {
        "title": "Oot Capable",
        "type": "boolean"
      }
    },
    "required": [
      "dataset",
      "dictionary",
      "oot_capable",
      "n_rows"
    ],
    "title": "LoadDatasetOutput",
    "type": "object"
  },
  "server": "data-profiler",
  "tool": "load_dataset",
  "version": "1.0.0"
}
