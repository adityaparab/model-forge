{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "binning_id": {
        "title": "Binning Id",
        "type": "string"
      },
      "corr_max": {
        "title": "Corr Max",
        "type": "number"
      },
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "fit_split": {
        "default": "train",
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Fit Split",
        "type": "string"
      },
      "iv_max": {
        "title": "Iv Max",
        "type": "number"
      },
      "iv_min": {
        "title": "Iv Min",
        "type": "number"
      },
      "max_features": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Max Features"
      },
      "split_id": {
        "title": "Split Id",
        "type": "string"
      }
    },
    "required": [
      "dataset_id",
      "split_id",
      "binning_id",
      "iv_min",
      "iv_max",
      "corr_max"
    ],
    "title": "SelectFeaturesInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "credit-modeling",
  "tool": "select_features",
  "version": "1.0.0"
}
