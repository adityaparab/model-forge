{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "early_stopping_rounds": {
        "default": 30,
        "title": "Early Stopping Rounds",
        "type": "integer"
      },
      "features": {
        "items": {
          "type": "string"
        },
        "title": "Features",
        "type": "array"
      },
      "fit_split": {
        "default": "train",
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Fit Split",
        "type": "string"
      },
      "model_name": {
        "title": "Model Name",
        "type": "string"
      },
      "params": {
        "anyOf": [
          {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Params"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "split_id": {
        "title": "Split Id",
        "type": "string"
      },
      "val_split": {
        "anyOf": [
          {
            "enum": [
              "train",
              "val",
              "oot"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": "val",
        "title": "Val Split"
      }
    },
    "required": [
      "dataset_id",
      "split_id",
      "features",
      "model_name",
      "seed"
    ],
    "title": "FitGbmInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "credit-modeling",
  "tool": "fit_gbm_challenger",
  "version": "1.0.0"
}
