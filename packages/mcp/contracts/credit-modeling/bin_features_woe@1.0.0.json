{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "features": {
        "items": {
          "type": "string"
        },
        "title": "Features",
        "type": "array"
      },
      "fit_split": {
        "default": "train",
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Fit Split",
        "type": "string"
      },
      "max_bins": {
        "default": 10,
        "title": "Max Bins",
        "type": "integer"
      },
      "method": {
        "default": "quantile",
        "enum": [
          "quantile",
          "tree"
        ],
        "title": "Method",
        "type": "string"
      },
      "min_bin_share": {
        "default": 0.05,
        "title": "Min Bin Share",
        "type": "number"
      },
      "monotonic": {
        "default": true,
        "title": "Monotonic",
        "type": "boolean"
      },
      "split_id": {
        "title": "Split Id",
        "type": "string"
      }
    },
    "required": [
      "dataset_id",
      "split_id",
      "features"
    ],
    "title": "BinFeaturesInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "credit-modeling",
  "tool": "bin_features_woe",
  "version": "1.0.0"
}
