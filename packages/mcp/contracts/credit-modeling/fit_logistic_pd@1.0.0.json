{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "binning_id": {
        "title": "Binning Id",
        "type": "string"
      },
      "c": {
        "default": 1.0,
        "title": "C",
        "type": "number"
      },
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "fit_split": {
        "default": "train",
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Fit Split",
        "type": "string"
      },
      "model_name": {
        "title": "Model Name",
        "type": "string"
      },
      "penalty": {
        "default": "l2",
        "enum": [
          "l2",
          "none"
        ],
        "title": "Penalty",
        "type": "string"
      },
      "selection_id": {
        "title": "Selection Id",
        "type": "string"
      },
      "split_id": {
        "title": "Split Id",
        "type": "string"
      },
      "stepwise": {
        "default": true,
        "title": "Stepwise",
        "type": "boolean"
      }
    },
    "required": [
      "dataset_id",
      "split_id",
      "binning_id",
      "selection_id",
      "model_name"
    ],
    "title": "FitLogisticInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "ArtifactRef": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "producer": {
            "anyOf": [
              {
                "$ref": "#/$defs/Producer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "summary": {
            "additionalProperties": true,
            "title": "Summary",
            "type": "object"
          }
        },
        "required": [
          "id",
          "kind",
          "media_type",
          "size_bytes"
        ],
        "title": "ArtifactRef",
        "type": "object"
      },
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "scorecard": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "selection": {
        "$ref": "#/$defs/ArtifactRef"
      }
    },
    "required": [
      "scorecard",
      "selection"
    ],
    "title": "FitLogisticOutput",
    "type": "object"
  },
  "server": "credit-modeling",
  "tool": "fit_logistic_pd",
  "version": "1.0.0"
}
