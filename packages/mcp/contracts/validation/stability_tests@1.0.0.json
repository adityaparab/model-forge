{
  "input_schema": {
    "$defs": {
      "Thresholds": {
        "additionalProperties": false,
        "properties": {
          "auc_min": {
            "default": 0.7,
            "title": "Auc Min",
            "type": "number"
          },
          "auc_warn": {
            "default": 0.65,
            "title": "Auc Warn",
            "type": "number"
          },
          "benchmark_gap": {
            "default": 0.03,
            "title": "Benchmark Gap",
            "type": "number"
          },
          "calibration_alpha": {
            "default": 0.05,
            "title": "Calibration Alpha",
            "type": "number"
          },
          "corr_max": {
            "default": 0.7,
            "title": "Corr Max",
            "type": "number"
          },
          "eo_high": {
            "default": 1.25,
            "title": "Eo High",
            "type": "number"
          },
          "eo_low": {
            "default": 0.8,
            "title": "Eo Low",
            "type": "number"
          },
          "gap_fail": {
            "default": 0.1,
            "title": "Gap Fail",
            "type": "number"
          },
          "gap_max": {
            "default": 0.05,
            "title": "Gap Max",
            "type": "number"
          },
          "grade_fail_share_warn": {
            "default": 0.2,
            "title": "Grade Fail Share Warn",
            "type": "number"
          },
          "hl_p_min": {
            "default": 0.05,
            "title": "Hl P Min",
            "type": "number"
          },
          "iv_max": {
            "default": 0.5,
            "title": "Iv Max",
            "type": "number"
          },
          "iv_min": {
            "default": 0.02,
            "title": "Iv Min",
            "type": "number"
          },
          "ks_min": {
            "default": 0.25,
            "title": "Ks Min",
            "type": "number"
          },
          "psi_fail": {
            "default": 0.25,
            "title": "Psi Fail",
            "type": "number"
          },
          "psi_warn": {
            "default": 0.1,
            "title": "Psi Warn",
            "type": "number"
          }
        },
        "title": "Thresholds",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "base_split": {
        "default": "train",
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Base Split",
        "type": "string"
      },
      "binning_id": {
        "title": "Binning Id",
        "type": "string"
      },
      "compare_split": {
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Compare Split",
        "type": "string"
      },
      "dataset_id": {
        "title": "Dataset Id",
        "type": "string"
      },
      "features": {
        "items": {
          "type": "string"
        },
        "title": "Features",
        "type": "array"
      },
      "n_bins": {
        "default": 10,
        "title": "N Bins",
        "type": "integer"
      },
      "scores_id": {
        "title": "Scores Id",
        "type": "string"
      },
      "thresholds": {
        "$ref": "#/$defs/Thresholds",
        "default": {
          "auc_min": 0.7,
          "auc_warn": 0.65,
          "benchmark_gap": 0.03,
          "calibration_alpha": 0.05,
          "corr_max": 0.7,
          "eo_high": 1.25,
          "eo_low": 0.8,
          "gap_fail": 0.1,
          "gap_max": 0.05,
          "grade_fail_share_warn": 0.2,
          "hl_p_min": 0.05,
          "iv_max": 0.5,
          "iv_min": 0.02,
          "ks_min": 0.25,
          "psi_fail": 0.25,
          "psi_warn": 0.1
        }
      }
    },
    "required": [
      "scores_id",
      "dataset_id",
      "binning_id",
      "features",
      "compare_split"
    ],
    "title": "StabilityInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "validation",
  "tool": "stability_tests",
  "version": "1.0.0"
}
