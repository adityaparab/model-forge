{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "alpha": {
        "default": 0.05,
        "title": "Alpha",
        "type": "number"
      },
      "n_grades": {
        "default": 10,
        "title": "N Grades",
        "type": "integer"
      },
      "scores_id": {
        "title": "Scores Id",
        "type": "string"
      },
      "split": {
        "enum": [
          "train",
          "val",
          "oot"
        ],
        "title": "Split",
        "type": "string"
      }
    },
    "required": [
      "scores_id",
      "split"
    ],
    "title": "CalibrationTestsInput",
    "type": "object"
  },
  "output_schema": {
    "$defs": {
      "Producer": {
        "additionalProperties": false,
        "properties": {
          "server": {
            "title": "Server",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "server",
          "tool",
          "version"
        ],
        "title": "Producer",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "media_type": {
        "title": "Media Type",
        "type": "string"
      },
      "producer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Producer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "size_bytes": {
        "title": "Size Bytes",
        "type": "integer"
      },
      "summary": {
        "additionalProperties": true,
        "title": "Summary",
        "type": "object"
      }
    },
    "required": [
      "id",
      "kind",
      "media_type",
      "size_bytes"
    ],
    "title": "ArtifactRef",
    "type": "object"
  },
  "server": "validation",
  "tool": "calibration_tests",
  "version": "1.0.0"
}
